# Production build configuration (card L1 — the invite gate is OPEN).
#
# Next inlines every NEXT_PUBLIC_* value at build time, and loads this file for
# `next build` / `next start` (production). This is the deliberate L1 release
# flip: sign-in is ON in production. Vercel dashboard variables override this
# file, so the operator can still gate a specific deploy from the dashboard.
#
# The Clerk keys themselves are secrets and are NOT committed — set
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY in the Vercel project.
NEXT_PUBLIC_AUTH_ENABLED=true
