# Copy to frontend/.env.local. Base URL of the AlphaDesk FastAPI backend.
# Use 127.0.0.1 (not localhost) to avoid IPv6 (::1) resolution issues on Windows.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Clerk identity (card F2) — OFF by default, and off is the shipped state.
#
# `false`/unset: no <ClerkProvider>, no middleware, no sign-in or waitlist
# route (both 404), no Authorization header, and none of Clerk's JavaScript is
# downloaded. The site behaves exactly as it did before card F2. Card L1 is the
# deliberate release that flips this to `true`.
#
# It is a BUILD-TIME value — Next inlines every NEXT_PUBLIC_* into the bundle —
# so changing it means rebuilding and redeploying, not restarting.
NEXT_PUBLIC_AUTH_ENABLED=false

# Clerk Dashboard -> Configure -> API keys. The publishable key is public by
# design (it is in every visitor's bundle already); the secret key is not, and
# NEXT_PUBLIC_ is exactly why the two have different prefixes.
#
# Required only when NEXT_PUBLIC_AUTH_ENABLED=true. A build with the flag on and
# a placeholder key still *builds* — the failure shows up in the browser, where
# Clerk cannot reach an instance that does not exist.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-side only. Read by clerkMiddleware() in frontend/middleware.ts and by
# Clerk's server helpers; never inlined into the bundle. On Vercel, set it as a
# plain (not NEXT_PUBLIC_) environment variable.
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# LOCAL MACHINE ONLY — NEVER SET THIS ON VERCEL OR ANY HOSTED ENVIRONMENT.
#
# Every NEXT_PUBLIC_* value is inlined into the JavaScript bundle that each
# visitor downloads, so setting this in a deployment publishes the key to
# /portfolio/* and /auth/* — the operator's real holdings, net worth and IND
# Money link — to anyone who opens devtools, and it stays in the bundles of
# every past deployment. Deployed, /portfolio is meant to show the locked state
# until card F3 lands per-user accounts.
#
# Uncomment locally, and match ALPHADESK_ADMIN_SECRET in backend/.env exactly.
# NEXT_PUBLIC_ALPHADESK_ADMIN_SECRET=
