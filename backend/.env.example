# AlphaDesk environment — copy to backend/.env and fill in.
#   cp backend/.env.example backend/.env   (PowerShell: Copy-Item)
# backend/.env is gitignored; never commit real keys.

# --- LLM -----------------------------------------------------------------
# Default: Groq.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
#
# Optional: route all LLM calls through an OpenAI-compatible endpoint instead.
# OPENAI_API_KEY is also required by most compatible providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# --- LangSmith tracing (recommended; CLAUDE.md says keep tracing on) -----
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=alphaDesk
# Region endpoint. Default is GCP US. Set this to your region or tracing 403s.
#   GCP US:   https://api.smith.langchain.com
#   GCP EU:   https://eu.api.smith.langchain.com
#   GCP APAC: https://apac.api.smith.langchain.com
#   AWS US:   https://aws.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# --- IND Money MCP server (required for live market data) ----------------
# Streamable-HTTP URL of the IND Money MCP server.
IND_MONEY_MCP_URL=

# --- Database (cards F1, S1) ---------------------------------------------
# Postgres connection string. `postgres://`, `postgresql://` and
# `postgresql+asyncpg://` are all accepted — the app and Alembic normalise to
# the asyncpg driver. Local Docker Postgres (see docs/TESTING/F1.md):
DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:5433/alphadesk
# Required for daily snapshots (S1): with no DATABASE_URL the dashboard still
# renders live totals, but `/portfolio/history` is permanently empty and
# nothing is ever captured. Run `cd backend && alembic upgrade head` after
# setting it, including on every deploy that ships a new migration.
# Fernet key encrypting broker tokens/secrets at rest. Losing or changing it
# makes every stored link undecryptable (users must re-link). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Broker (optional) ---------------------------------------------------
# Leave blank for paper-trading only. No real orders are placed unless a
# BrokerAdapter is configured (see backend/broker/README.md).
BROKER=

# --- AlphaDesk access control (V2_PLAN.md, C0) ---------------------------
# Single-tenant dev mode: enables the ambient IND Money credential fallbacks
# (IND_MONEY_MCP_TOKEN / IND_MONEY_OAUTH_* env, the Claude Code store) and
# bypasses the admin gate on /auth/login and /auth/logout. Set to 1 on local
# machines only — it MUST stay unset in any deployed environment.
ALPHADESK_SINGLE_TENANT=1
# ALPHADESK_ADMIN_SECRET — REMOVED at L1. The interim C0/D1 admin-header gate
# that briefly guarded /portfolio/* is gone; /portfolio/* and /auth/* are
# JWT-only (per-user Clerk auth). This var is read nowhere; do not set it.

# --- Clerk identity (card F2) --------------------------------------------
# Verifies the Clerk session token on `Authorization: Bearer` in
# backend/api/deps.py. Both values come from the same place: Clerk Dashboard ->
# Configure -> API keys -> "Show API URLs" -> Frontend API URL, e.g.
# https://tidy-mayfly-99.clerk.accounts.dev (a production instance uses your own
# clerk.<domain> instead). Nothing here is a secret — a JWKS is public by
# design, which is exactly why the backend needs no CLERK_SECRET_KEY.
#
# Unset, `current_user` answers 503 on every call — it never runs open. Nothing
# in the app depends on it until F3, so leaving these blank is fine today.
#
# <frontend-api>/.well-known/jwks.json — note the `.json`: a production custom
# domain serves ONLY that path, while a *.clerk.accounts.dev dev domain also
# answers /.well-known/jwks, so a URL that works in dev can 404 in production.
CLERK_JWKS_URL=
# The token's `iss` claim, verified exactly. This is the Frontend API URL with
# no path — same host as above, nothing appended.
CLERK_ISSUER=
# **REQUIRED as of F3.** Comma-separated origins allowed in the token's `azp`
# claim. Clerk's own guidance is that leaving it unset "can open your
# application to CSRF attacks", and a check that switches itself off when an env
# var is forgotten is not a check — so unset now answers 503 at auth time, the
# same as an unset issuer. Set it to every origin that will call this API:
#   https://alphadesk.vercel.app,http://localhost:3000
# Verified against the live instance: a *browser*-minted session token carries
# `azp` = the page origin. A token minted through the Clerk Backend API carries
# none and is therefore rejected here, which is correct — it is not a browser
# session.
CLERK_AUTHORIZED_PARTIES=
# Optional, and only for one thing: resolving a signing-in user's **verified
# primary email** so `ALPHADESK_OPERATOR_EMAIL` below can be matched. A default
# Clerk session token carries no email claim at all, so without this key
# adoption simply never runs (a safe, recoverable state). Nothing else in the
# backend uses it — the token check is still key-less.
# CLERK_SECRET_KEY=

# --- One-off adoption of the pre-F3 data (card F3) ------------------------
# Everything AlphaDesk stored before per-user identity is keyed on
# user_id="local" — the operator's broker link and, crucially, every daily
# net-worth snapshot since S1 (a point-in-time source: a lost day is lost).
# Setting this to the operator's Clerk email hands those rows to that account
# the first time they sign in. Matched against their VERIFIED PRIMARY address
# only, and never against "whoever signs in first". Unset ⇒ adoption never runs.
# ALPHADESK_OPERATOR_EMAIL=

# --- Nightly snapshot job (card S1) --------------------------------------
# Shared secret guarding POST /internal/snapshot and /internal/prune, sent as
# the x-cron-secret header by .github/workflows/snapshot.yml. **Deliberately a
# different secret from ALPHADESK_ADMIN_SECRET**: a scheduled CI runner must
# not hold a key that can also read holdings or unlink the account.
# Fail-closed — unset means those routes answer 503, never that they run open.
# Set the SAME value as a Space secret and as the GitHub Actions secret
# `CRON_SECRET`. Generate with:
#   openssl rand -base64 32
# CRON_SECRET=
