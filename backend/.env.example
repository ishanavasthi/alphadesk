# AlphaDesk environment — copy to backend/.env and fill in.
#   cp backend/.env.example backend/.env   (PowerShell: Copy-Item)
# backend/.env is gitignored; never commit real keys.

# --- LLM -----------------------------------------------------------------
# Default: Groq.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
#
# Optional: route all LLM calls through an OpenAI-compatible endpoint instead.
# OPENAI_API_KEY is also required by most compatible providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# --- LangSmith tracing (recommended; CLAUDE.md says keep tracing on) -----
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=alphaDesk
# Region endpoint. Default is GCP US. Set this to your region or tracing 403s.
#   GCP US:   https://api.smith.langchain.com
#   GCP EU:   https://eu.api.smith.langchain.com
#   GCP APAC: https://apac.api.smith.langchain.com
#   AWS US:   https://aws.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# --- IND Money MCP server (required for live market data) ----------------
# Streamable-HTTP URL of the IND Money MCP server.
IND_MONEY_MCP_URL=

# --- Database (card F1) --------------------------------------------------
# Postgres connection string. `postgres://`, `postgresql://` and
# `postgresql+asyncpg://` are all accepted — the app and Alembic normalise to
# the asyncpg driver. Local Docker Postgres (see docs/TESTING/F1.md):
DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:5433/alphadesk
# Fernet key encrypting broker tokens/secrets at rest. Losing or changing it
# makes every stored link undecryptable (users must re-link). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Broker (optional) ---------------------------------------------------
# Leave blank for paper-trading only. No real orders are placed unless a
# BrokerAdapter is configured (see backend/broker/README.md).
BROKER=

# --- AlphaDesk access control (V2_PLAN.md, C0) ---------------------------
# Single-tenant dev mode: enables the ambient IND Money credential fallbacks
# (IND_MONEY_MCP_TOKEN / IND_MONEY_OAUTH_* env, the Claude Code store) and
# bypasses the admin gate on /auth/login and /auth/logout. Set to 1 on local
# machines only — it MUST stay unset in any deployed environment.
ALPHADESK_SINGLE_TENANT=1
# Deployed environments only (set as an HF Space *secret*, not here): shared
# secret guarding /auth/login and /auth/logout until per-user auth (F3).
# Sent as the x-alphadesk-admin-secret header. Generate with:
#   openssl rand -base64 32
# ALPHADESK_ADMIN_SECRET=
